{
  "manifest_version": 3,
  "name": "AutenticAI",
  "description": "Projeto acadêmico do SENAI para investigar informações.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "icons": { "128": "icon-128.png" },
  "background": {
    "service_worker": "auth.js"
  },
  "action": {
    "default_title": "AutenticAI",
    "default_icon": "icon-128.png",
    "default_popup": "popup.html"
  }
}
